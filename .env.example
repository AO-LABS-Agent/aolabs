# Optional build-time defaults for the in-app Settings page.
# AOLABS needs no .env file to run: everything can be set from Settings in
# the UI (stored in your browser's localStorage). These variables only
# pre-fill the Settings form when present at build time.
#
# VITE_LLM_PROVIDER=openai
# VITE_LLM_BASE_URL=https://api.openai.com/v1
# VITE_LLM_API_KEY=
# VITE_LLM_MODEL=gpt-4o-mini
# VITE_RPC_URL=
